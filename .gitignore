.ferrosift-private/
.worktrees/
# Every build directory, including the out-of-workspace task runner's.
target/

# The pinned reference checkout is fetched by `cargo xtask cyberchef setup`,
# never committed: it is large and belongs to upstream.
tools/cyberchef-oracle/vendor/

# Non-baseline profiles are committed as deltas against the baseline
# (`*.overlay.json`), not as second copies of a million bytes that agree.
# `cargo xtask cyberchef generate` still writes the full files so they can be
# inspected; `overlay` condenses them and these keep them out of the tree.
crates/ferrosift-operations/tests/fixtures/cyberchef-v11.4.0/corpus.json
crates/ferrosift-operations/tests/fixtures/cyberchef-v11.4.0/differential.json

lcov.info
bench/target/
